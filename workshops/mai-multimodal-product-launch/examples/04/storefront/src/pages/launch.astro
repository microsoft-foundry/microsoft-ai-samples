---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';

const radioTranscript = 'Rain in the forecast? Bring it! The Trailmaster X4 from Outdoor Living sleeps four, stands up on its own, and comes with its own rainfly. Home, anywhere, for $250. Find it at Contoso Outdoors.';
const launchAssets = fs.readdirSync('public/launch/assets', { withFileTypes: true })
  .filter((entry) => entry.isFile() && entry.name.endsWith('.webp'))
  .map((entry) => {
    const fileName = entry.name;
    const stem = fileName.replace(/\.webp$/, '').replace(/\d+-/, '').replace(/-/g, ' ');
    return { fileName, stem, title: stem.replace(/\b\w/g, (letter) => letter.toUpperCase()) };
  })
  .sort((a, b) => a.fileName.localeCompare(b.fileName, undefined, { numeric: true }));
---
<BaseLayout title="TrailMaster X4 Launch | Contoso Outdoors">
  <article class="launch">
    <header class="launch-header">
      <div>
        <p class="eyebrow">OutdoorLiving · $250</p>
        <h1>TrailMaster X4</h1>
        <p>A water-resistant, 4-person tent with a rainfly and a freestanding design.</p>
        <a href="/products/trailmaster-x4-tent">View product details</a>
      </div>
      <figure>
        <img src="/launch/launch-poster.webp" alt="TrailMaster X4 launch poster" />
        <figcaption>AI-generated launch picture</figcaption>
      </figure>
    </header>

    <section class="media-grid" aria-label="TrailMaster X4 launch media">
      <figure>
        <img src="/launch/four-seasons.webp" alt="TrailMaster X4 shown for four seasons" />
        <figcaption>AI-generated picture · Four seasons</figcaption>
      </figure>
      <figure>
        <img src="/launch/setup-guide.webp" alt="TrailMaster X4 setup guide" />
        <figcaption>AI-generated picture · Setup guide</figcaption>
      </figure>
    </section>

    <section class="radio" aria-labelledby="radio-heading">
      <div>
        <p class="eyebrow">English radio spot</p>
        <h2 id="radio-heading">Meet the TrailMaster X4</h2>
        <audio controls preload="metadata" src="/launch/trailmaster-radio-en.mp3">
          Your browser does not support the audio element.
        </audio>
        <span class="ai-label">AI-generated voice</span>
      </div>
      <aside aria-label="Radio spot transcript">
        <h3>Captions</h3>
        <p>{radioTranscript}</p>
      </aside>
    </section>

    <section class="launch-assets" aria-labelledby="launch-assets-heading">
      <div class="assets-heading">
        <div>
          <p class="eyebrow">Generated media library</p>
          <h2 id="launch-assets-heading">Launch Assets</h2>
        </div>
        <p class="asset-count">{launchAssets.length} images</p>
      </div>
      <div class="asset-grid">
        {launchAssets.map((asset, index) => (
          <button
            type="button"
            class="asset-card"
            data-index={index}
            data-title={asset.title}
            data-file={asset.fileName}
            data-src={`/launch/assets/${asset.fileName}`}
            aria-label={`View details for ${asset.title}`}
          >
            <img src={`/launch/assets/${asset.fileName}`} alt={asset.title} loading="lazy" />
            <span class="asset-card-copy">
              <strong>{asset.title}</strong>
              <span>AI-generated image</span>
            </span>
          </button>
        ))}
      </div>
    </section>

    <dialog class="asset-dialog" aria-labelledby="asset-dialog-title">
      <div class="dialog-shell">
        <button type="button" class="dialog-close" aria-label="Close image viewer">×</button>
        <figure>
          <img id="asset-dialog-image" src="" alt="" />
        </figure>
        <div class="dialog-details">
          <p class="eyebrow">Launch asset</p>
          <h2 id="asset-dialog-title"></h2>
          <dl>
            <div><dt>File</dt><dd id="asset-dialog-file"></dd></div>
            <div><dt>Type</dt><dd>AI-generated WebP image</dd></div>
          </dl>
        </div>
      </div>
    </dialog>
  </article>
</BaseLayout>

<script>
  const assetCards = document.querySelectorAll('.asset-card');
  const dialog = document.querySelector('.asset-dialog');
  const dialogImage = document.querySelector('#asset-dialog-image');
  const dialogTitle = document.querySelector('#asset-dialog-title');
  const dialogFile = document.querySelector('#asset-dialog-file');
  const dialogClose = document.querySelector('.dialog-close');

  assetCards.forEach((card) => {
    card.addEventListener('click', () => {
      dialogImage.src = card.dataset.src;
      dialogImage.alt = card.dataset.title;
      dialogTitle.textContent = card.dataset.title;
      dialogFile.textContent = card.dataset.file;
      dialog.showModal();
    });
  });

  dialogClose?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .launch-header { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  .launch-header, .radio { border: 1px solid var(--line); border-radius: 8px; padding: 24px; background: var(--surface-raised); box-shadow: var(--shadow); }
  figure { margin: 0; }
  img { width: 100%; height: 420px; object-fit: contain; }
  figcaption, .ai-label { display: block; margin-top: 8px; font-size: 0.85rem; font-weight: 700; }
  .eyebrow { margin: 0; text-transform: uppercase; font-weight: 700; }
  h1 { margin: 8px 0 16px; font-size: clamp(2.4rem, 6vw, 5rem); line-height: 0.95; }
  h2 { margin: 8px 0 16px; }
  .launch-header a { display: inline-block; margin-top: 12px; border: 1px solid var(--accent); border-radius: 6px; padding: 10px 14px; background: var(--accent); color: var(--accent-contrast); text-decoration: none; font-weight: 700; }
  .media-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0; }
  .media-grid figure { border: 1px solid var(--line); border-radius: 6px; padding: 16px; background: var(--surface); }
  .radio { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  audio { width: min(420px, 100%); margin-top: 8px; }
  aside { border-left: 1px solid var(--line); padding-left: 24px; }
  aside h3 { margin-top: 0; }
  .launch-assets { margin-top: 24px; border: 1px solid var(--line); border-radius: 8px; padding: 24px; background: var(--surface-raised); box-shadow: var(--shadow); }
  .assets-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
  .assets-heading h2 { margin: 6px 0 0; font-size: clamp(2rem, 4vw, 3.25rem); }
  .asset-count { margin: 0; color: var(--muted); font-weight: 800; }
  .asset-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .asset-card { position: relative; aspect-ratio: 4 / 3; display: block; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--papaya-whip); padding: 0; overflow: hidden; cursor: pointer; isolation: isolate; }
  .asset-card::after { content: ""; position: absolute; inset: 45% 0 0; z-index: 1; background: linear-gradient(to bottom, transparent, rgba(0, 21, 36, 0.92)); }
  .asset-card:hover { border-color: var(--vivid-tangerine); }
  .asset-card:focus-visible { outline: 3px solid var(--vivid-tangerine); outline-offset: 3px; }
  .asset-card img { width: 100%; height: 100%; object-fit: cover; }
  .asset-card-copy { position: absolute; inset: auto 0 0; z-index: 2; display: grid; gap: 3px; text-align: left; padding: 12px; }
  .asset-card-copy strong { font-family: "Fraunces", Georgia, serif; line-height: 1.05; text-wrap: balance; }
  .asset-card-copy span { font-size: 0.78rem; }
  .asset-dialog { width: min(920px, calc(100vw - 32px)); max-height: calc(100vh - 32px); border: 0; border-radius: 8px; background: transparent; padding: 0; color: var(--ink); overflow: visible; }
  .asset-dialog::backdrop { background: rgba(0, 21, 36, 0.78); backdrop-filter: blur(6px); }
  .dialog-shell { position: relative; max-height: calc(100vh - 32px); display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(220px, 0.45fr); border: 1px solid var(--line); border-radius: 8px; background: var(--surface-raised); box-shadow: var(--shadow); overflow: hidden; }
  .dialog-shell figure { min-height: 0; margin: 0; background: var(--ink-black); }
  .dialog-shell figure img { width: 100%; height: min(72vh, 620px); object-fit: contain; }
  .dialog-details { align-self: stretch; padding: 28px 24px; }
  .dialog-details h2 { margin: 8px 0 20px; line-height: 1.05; text-wrap: balance; }
  .dialog-details dl { margin: 0; }
  .dialog-details dl div { border-top: 1px solid var(--line); padding: 12px 0; }
  .dialog-details dt { color: var(--muted); font-size: 0.78rem; font-weight: 800; text-transform: uppercase; }
  .dialog-details dd { margin: 4px 0 0; overflow-wrap: anywhere; }
  .dialog-close { position: absolute; right: 10px; top: 10px; z-index: 3; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 999px; background: var(--papaya-whip); color: var(--ink-black); box-shadow: var(--shadow); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  @media (max-width: 900px) { .asset-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .dialog-shell { grid-template-columns: 1fr; overflow-y: auto; } .dialog-shell figure img { height: min(55vh, 480px); } }
  @media (max-width: 700px) { .launch-header, .media-grid, .radio { grid-template-columns: 1fr; } img { height: 300px; } aside { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; padding-top: 16px; } .asset-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .asset-count { display: none; } .dialog-shell { max-height: calc(100vh - 32px); } .dialog-details { padding: 20px; } }
</style>
