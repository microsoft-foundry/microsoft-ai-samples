---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products.js';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---
<BaseLayout title={`${product.name} | Contoso Outdoors`}>
  <article class="product">
    <div class="photo">
      <img src={product.image} alt={product.name} />
      <span>Photo Gallery (swipe)</span>
    </div>
    <div class="details">
      <p class="brand">{product.brand}</p>
      <h1>{product.name}</h1>
      <strong class="price">${product.price}</strong>
      <h2>Features</h2>
      <ul>
        {product.features.map((feature) => <li>{feature}</li>)}
      </ul>
      <button type="button">Add to cart</button>
      {product.slug === 'trailmaster-x4-tent' && <a class="launch-link" href="/launch">See the TrailMaster X4 launch page</a>}
    </div>
  </article>
</BaseLayout>

<style>
  .product { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; border: 1px solid var(--line); border-radius: 8px; padding: 32px; background: var(--surface-raised); box-shadow: var(--shadow); }
  .photo { border: 1px solid var(--line); border-radius: 6px; padding: 16px; text-align: center; background: var(--surface); }
  .photo img { width: 100%; height: 420px; object-fit: contain; }
  .photo span { display: inline-block; margin-top: 12px; }
  .brand { margin: 0; font-weight: 700; }
  h1 { margin: 8px 0 16px; font-size: clamp(2rem, 4vw, 3.5rem); }
  .price { font-size: 1.6rem; }
  h2 { margin-top: 28px; font-size: 1.1rem; }
  ul { padding-left: 20px; line-height: 1.55; }
  button { border: 1px solid var(--accent); border-radius: 6px; padding: 12px 18px; background: var(--accent); color: var(--accent-contrast); font-weight: 800; cursor: pointer; }
  .launch-link { display: inline-block; margin-left: 12px; font-weight: 700; text-underline-offset: 4px; }
  @media (max-width: 700px) { .product { grid-template-columns: 1fr; } .photo img { height: 300px; } }
</style>
