# Copy to .env (here or at the repository root) and fill in your values.
# Microsoft Foundry project connection
MICROSOFT_FOUNDRY_ENDPOINT=
MICROSOFT_FOUNDRY_API_KEY=

# Deployment / model names used by this sample
AZURE_COVER_ART_DEPLOYMENT=cover-art
AZURE_DECISION_1_DEPLOYMENT=decision-1
AZURE_SLIDE_ART_DEPLOYMENT=slide-art
AZURE_SLIDE_WRITER_DEPLOYMENT=slide-writer

# Azure Speech resource
AZURE_SPEECH_ENDPOINT=
